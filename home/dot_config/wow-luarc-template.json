{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "runtime.builtin": {
    "basic": "disable",
    "debug": "disable",
    "io": "disable",
    "math": "disable",
    "os": "disable",
    "package": "disable",
    "string": "disable",
    "table": "disable",
    "utf8": "disable"
  },
  "workspace.library": [
    "~/.local/share/wow-annotations/Annotations/Core",
    "~/.local/share/wow-annotations/Annotations/FrameXML",
    "~/.local/share/wow-libs/ElvUI/ElvUI/Game/Shared",
    "~/.local/share/wow-libs/ElvUI/ElvUI/Game/Mainline",
    "~/.local/share/wow-libs/ElvUI/ElvUI_Libraries/Game/Shared"
  ],
  "workspace.checkThirdParty": false,
  "type.weakUnionCheck": true,
  "diagnostics.globals": [],
  "diagnostics.disable": ["assign-type-mismatch"]
}
