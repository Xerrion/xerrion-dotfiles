# Patterns for files that chezmoi should NOT manage.
# One glob per line. Supports negation with !.

# Neovim machine-specific state
dot_config/nvim/lazy-lock.json
dot_config/nvim/.luarc.json

# Zed local state (prompts LMDB, installed themes) - never manage via chezmoi.
# Patterns match target (destination) paths, not source-state names.
.config/zed/prompts/
.config/zed/themes/
AppData/Roaming/Zed/prompts/
AppData/Roaming/Zed/themes/

# PowerShell profile + Windows-only Zed path
{{ if ne .chezmoi.os "windows" }}
Documents/
AppData/
{{ end }}

# macOS/Linux-only Zed path: exclude on Windows so only the AppData copy lands
{{ if eq .chezmoi.os "windows" }}
.config/zed/
{{ end }}
