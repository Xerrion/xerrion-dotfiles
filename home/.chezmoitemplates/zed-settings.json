// Zed settings - managed by chezmoi. See https://zed.dev/docs/configuring-zed
{
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato"
  },
  "ui_font_family": "Inter",
  "ui_font_size": 16,
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_size": 15,
  "buffer_font_features": {
    "calt": true,
    "liga": true
  },
  "buffer_line_height": "comfortable",
  "cursor_blink": false,
  "cursor_shape": "bar",
  "relative_line_numbers": true,
  "soft_wrap": "preferred_line_length",
  "preferred_line_length": 120,
  "wrap_guides": [80, 120],
  "show_wrap_guides": true,
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "tab_size": 2,
  "hard_tabs": false,
  "use_autoclose": true,
  "always_treat_brackets_as_autoclosed": true,
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50
  },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
      "delay_ms": 600,
      "show_commit_summary": true
    },
    "hunk_style": "staged_hollow"
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
    "background_coloring": "disabled"
  },
  "scrollbar": {
    "show": "auto",
    "git_diff": true,
    "selected_text": true,
    "symbols_selections": true,
    "diagnostics": "all"
  },
  "minimap": {
    "show": "never"
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "close_position": "right"
  },
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": true
  },
  "project_panel": {
    "dock": "left",
    "default_width": 260,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 14,
    "auto_reveal_entries": true
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "terminal": {
    "dock": "bottom",
    "default_height": 320,
    "font_family": "FiraCode Nerd Font",
    "font_size": 14,
    "shell": "system",
    "blinking": "off",
    "copy_on_select": true,
    "button": true
  },
  "search": {
    "whole_word": false,
    "case_sensitive": false,
    "include_ignored": false,
    "regex": false
  },
  "use_smartcase_search": true,
  "diagnostics": {
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": "hint"
    }
  },
  "lsp_highlight_debounce": 75,
  "features": {
    "edit_prediction_provider": "zed"
  },
  "agent_servers": {
    "opencode": {
      "type": "registry"
    }
  },
  "agent": {
    "enabled": true,
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4"
    }
  },
  "edit_predictions": {
    "mode": "eager",
    "enabled_in_text_threads": true
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/.pytest_cache",
    "**/__pycache__",
    "**/target",
    "**/dist",
    "**/build"
  ],
  "languages": {
    "Lua": {
      "tab_size": 4
    },
    "Go": {
      "tab_size": 4,
      "hard_tabs": true
    },
    "Python": {
      "tab_size": 4,
      "format_on_save": "on"
    },
    "Rust": {
      "tab_size": 4
    },
    "Markdown": {
      "soft_wrap": "preferred_line_length",
      "preferred_line_length": 80,
      "format_on_save": "off"
    },
    "YAML": {
      "tab_size": 2
    },
    "TOML": {
      "tab_size": 2
    }
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },
  "auto_update": true,
  "confirm_quit": false,
  "restore_on_startup": "last_workspace",
  "close_on_file_delete": false
}
