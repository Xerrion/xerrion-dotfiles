{{ if eq .chezmoi.os "windows" -}}
#!/usr/bin/env pwsh
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Write-Error "Scoop not found. run_once_before_10-install-scoop.ps1 must run first."
    exit 1
}

$installed = @(scoop list | Select-Object -ExpandProperty Name)

$packages = @(
{{ range .packages.windows.scoop -}}
    "{{ . }}",
{{ end -}}
{{ range .packages.windows.fonts -}}
    "{{ . }}",
{{ end -}}
{{ range .packages.windows.scoop_gui -}}
    "{{ . }}",
{{ end -}}
  $null
)

foreach ($pkg in $packages) {
    if ($null -eq $pkg) { continue }
    # scoop name may include bucket prefix (e.g. "extras/zed"); match on bare name
    $bare = $pkg -replace '^[^/]+/', ''
    if ($installed -contains $bare) {
        Write-Host "==> Already installed: $pkg"
    } else {
        Write-Host "==> Installing: $pkg"
        scoop install $pkg
    }
}
{{ end -}}
